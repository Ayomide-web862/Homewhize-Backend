# === BACKEND ENVIRONMENT VARIABLES ===
# NEVER commit your real .env file to git!
# Copy this file to .env and fill in real values

# ===== SERVER CONFIG =====
PORT=5000
NODE_ENV=production
FORCE_HTTPS=true

# ===== DATABASE (MySQL) =====
# For cPanel MySQL: use your cPanel account hostname (e.g., 185.x.x.x or cpanel.domain.com)
# DO NOT use 'localhost' - it won't work on remote hosting
DB_HOST=your_cpanel_mysql_host       # e.g., 185.136.233.XXX or db.cpanel.com
DB_USER=database_username             # e.g., account_dbuser
DB_PASSWORD=secure_database_password  # Use strong password (32+ chars)
DB_NAME=database_name                 # e.g., account_tablename
DB_CONN_LIMIT=10
DB_CONNECT_TIMEOUT=20000
DB_SSL=false                           # Set to 'true' ONLY if hosting requires SSL (ask support)

# ===== AUTHENTICATION =====
JWT_SECRET=your_extremely_secure_jwt_secret_minimum_32_characters_required_change_this

# ===== FRONTEND URLS (CORS) =====
# Comma-separated list of allowed frontend origins
FRONTEND_URLS=https://yourdomain.com,https://www.yourdomain.com

# ===== EMAIL (Gmail with App Password) =====
# Use Gmail App-Specific Password (not regular password)
# Generate at: https://myaccount.google.com/apppasswords
# If you use Gmail set EMAIL_SERVICE=gmail and provide EMAIL_USER/EMAIL_PASS (app password)
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password  # NOT your regular Gmail password

# ===== GOOGLE OAUTH =====
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ===== CLOUDINARY (Image Storage) =====
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===== PAYMENTS (Paystack) =====
# Get your test secret key from Paystack dashboard and set it in production cPanel env
PAYSTACK_SECRET_KEY=sk_test_xxx_replace_with_yours
# Optional callback URL (where Paystack redirects after payment)
PAYSTACK_CALLBACK_URL=https://api.yourdomain.com/api/payments/callback
